# Copy settings into the server's environment. Never commit .env or real API keys.
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000
HOST=127.0.0.1
# Free basic scans; verified holders unlock deeper scans and CSV/JSON exports.
BUNDLE_ACCESS_MODE=free-basic
# Required for verified Pro access: the exact SPL mint and decimal token count.
HOLDER_TOKEN_MINT=
HOLDER_MIN_TOKENS=
# A dedicated archival Solana mainnet RPC is recommended. Keep credentials server-side.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Native launch analysis needs no Gatekept key.
# Optional legacy comparison adapter only: GATEKEPT_API_KEY may be set separately.
# Required for Pro on Vercel or multiple Node instances (server-side secrets).
STATE_REDIS_REST_URL=
STATE_REDIS_REST_TOKEN=
